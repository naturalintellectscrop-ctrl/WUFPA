---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/layout/Section.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import Prose from '../../components/layout/Prose.astro';
import Creed from '../../components/content/Creed.astro';
import IndexList from '../../components/content/IndexList.astro';
import RelatedLinks from '../../components/content/RelatedLinks.astro';
import { meta } from '../../lib/page-meta';

/**
 * /regions/ — docs/04 § 7.
 *
 * THE ORGANISING INSIGHT OF THE WHOLE SITE (docs/05 § 1). Uganda's film
 * industry has always been concentrated in Kampala; WUFPA's answer was to
 * build leadership in every sub-region rather than open one office and hope
 * people travelled to it. This page is where a filmmaker in Kanungu finds
 * that there is someone in Kabale who covers their district.
 *
 * Card descriptions are the per-region opening lines from docs/04 § 7.1 —
 * the only region-specific prose on the site. Everything else on a region
 * page is data, which is what lets six pages exist without six sets of
 * invented copy.
 */

const page = meta('/regions/');
const crumbs = [{ label: 'Home', href: '/' }, { label: 'Our six sub-regions' }];

const regions = (await getCollection('regions')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title={page.title} description={page.description} crumbs={crumbs} pageType="CollectionPage">
  <PageHeader
    title="Our six sub-regions"
    standfirst="WUFPA covers Ankole (Rwizi), Kigezi, Rwenzori, Tooro, Bunyoro and Greater Bushenyi. Each has a coordinator, a secretary and a treasurer, with district coordinators working alongside them."
    crumbs={crumbs}
  />

  {/* The organising insight of the whole site, set as a statement rather than
      as a paragraph under a heading. This one sentence is why WUFPA exists in
      the shape it does, and it is the sentence a funder or a filmmaker should
      leave the page having read. */}
  <Section labelledBy="why-heading" spacing="loose">
    <Creed
      label="Why we organise by sub-region"
      labelId="why-heading"
      statement="Uganda’s film industry has always been concentrated in Kampala."
    >
      <Prose>
        <p>
          WUFPA’s answer was not to open one office and hope people travelled to it, but to
          build leadership in every sub-region. Sub-regional committees were introduced
          specifically to decentralise governance and deliver programmes efficiently.
        </p>
      </Prose>
    </Creed>
  </Section>

  {/* An index, not six cards. Six equal boxes told a filmmaker in Kanungu that
      the six sub-regions are interchangeable; a numbered index sets them as
      one continuous list, with the districts each one covers as the row's
      record line — which is the information that actually answers "is my
      district in there?". */}
  <Section labelledBy="regions-heading" variant="subtle" spacing="loose" reveal>
    <h2 id="regions-heading">Find your sub-region</h2>
    <p class="band-note">
      Each sub-region has a coordinator, a secretary and a treasurer, with district
      coordinators working alongside them.
    </p>
    <IndexList
      class="regions-index"
      items={regions.map((region) => ({
        title: region.data.title,
        href: `/regions/${region.data.key}/`,
        description: region.data.opening,
        meta: region.data.districts.join(' · '),
      }))}
    />
  </Section>

  <Section labelledBy="next-heading" container="narrow" reveal>
    <h2 id="next-heading" class="u-visually-hidden">Where to go next</h2>
    <RelatedLinks
      heading="Elsewhere on this site"
      links={[
        {
          href: '/membership/join/',
          label: 'Become a member',
          reason: 'Your enquiry routes to the coordinator for the sub-region you name.',
        },
        {
          href: '/guilds/',
          label: 'The ten guilds',
          reason: 'Organised by craft rather than by place — the other half of the structure.',
        },
        {
          href: '/about/governance/',
          label: 'How WUFPA is governed',
          reason: 'How the sub-regional committees fit into the association.',
        },
      ]}
    />
  </Section>
</BaseLayout>

<style>
  .band-note {
    margin: var(--space-3) 0 0;
    max-inline-size: var(--measure-narrow);
    font-size: var(--text-lg);
    color: var(--text-secondary);
  }

  .regions-index {
    margin-block-start: var(--space-7);
  }
</style>
