---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/layout/Section.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import FeatureRow from '../../components/content/FeatureRow.astro';
import EstablishingShot from '../../components/content/EstablishingShot.astro';
import RelatedLinks from '../../components/content/RelatedLinks.astro';
import Button from '../../components/primitives/Button.astro';
import { getPhoto } from '../../lib/photos';
import { meta } from '../../lib/page-meta';

/**
 * /programmes/training/: docs/04 § 6.2, verbatim.
 *
 * ART DIRECTION. The argument here is that training in Western Uganda is a
 * thing that happens rather than a thing that is offered: six real sessions,
 * each with named partners and, for most, a photograph of the room. So the
 * delivered-training list is the page, not a footnote to it, and each entry
 * gets an editorial spread with its own photograph rather than a place in a
 * grid.
 *
 * The partner roll is typographic. Six institution names set at scale are
 * their own credential; putting them in boxes would add six containers to a
 * page whose argument is the names inside them (docs/21 § 10). No logos:
 * ⟦Q10⟧, written permission has not been obtained, and several are government
 * bodies and diplomatic missions with strict identity rules.
 */

const page = meta('/programmes/training/');
const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'What we do', href: '/programmes/' },
  { label: 'Training and master classes' },
];

const cohort = getPhoto('programmes/training/matatu-film-lab-cohort-2024.jpeg');

/* docs/04 § 6.2, verbatim from [P2]. */
const partners = [
  'UCC / CineArts Academy',
  'US Mission Uganda / Film Possible Uganda',
  'Alliance Française and the Goethe-Zentrum',
  'Uganda Film Network',
  'UNATCOM (the Uganda National Commission for UNESCO)',
  'National Producers Guild of Uganda (PGU)',
];

/* Delivered training, docs/04 § 6.2. Each carries the photograph of that
   specific session. `photo: null` where the archive holds none: the entry
   still stands, because the session still happened. */
const delivered = [
  {
    title: 'Master classes with Kampala Film School',
    detail: 'For the UCC Western Region Film Competition Festival.',
    photo: 'programmes/training/ucc-master-class-kampala-film-school-session.jpeg',
  },
  {
    title: 'The Matatu Film Lab',
    detail:
      'With Film Possible and US Mission Uganda, led by international mentor Zavaleta Janson, 2024.',
    photo: 'programmes/training/matatu-film-lab-training-room-2024.jpeg',
  },
  {
    title: 'Monetising film content',
    detail: 'With MTN YoTV, 2023: how members earn from the YoTV channel.',
    photo: 'programmes/training/mtn-yotv-monetisation-workshop-2023.jpeg',
  },
  {
    title: 'Training workshop with UNATCOM for UNESCO',
    detail: 'Delivered with the Uganda National Commission for UNESCO.',
    photo: 'programmes/training/unatcom-unesco-training-workshop.jpeg',
  },
  {
    title: 'A workshop with Film Impact Movement (USA)',
    detail: 'Hosted with the Film Impact Movement.',
    photo: 'programmes/training/film-impact-movement-usa-workshop.jpeg',
  },
  {
    title: 'A visit from US film expert Joshua Stoone',
    detail: '2023.',
    photo: 'programmes/training/joshua-stoone-us-film-expert-2023.jpeg',
  },
].map((item) => ({ ...item, media: getPhoto(item.photo) }));
---

<BaseLayout title={page.title} description={page.description} crumbs={crumbs}>
  <PageHeader
    title="Training and master classes"
    standfirst="Skills in screenwriting, directing, acting, cinematography, editing and production, taught in the sub-regions, not only in Kampala."
    crumbs={crumbs}
  />

  <Section labelledBy="intro-heading" container="reading" spacing="loose">
    <h2 id="intro-heading" class="u-visually-hidden">Why we train</h2>
    <p class="lead">
      Capacity building is WUFPA’s first core objective: to develop skills among members
      through workshops, mentorships and hands-on training.
    </p>
  </Section>

  {/* The partner roll: names at scale, no boxes, no logos (⟦Q10⟧). */}
  <Section labelledBy="partners-heading" variant="subtle" reveal>
    <div class="roll">
      <div class="roll__intro">
        <h2 id="partners-heading">Who we train with</h2>
        <p class="band-note">
          WUFPA receives annual workshops and training support from national and international
          partners.
        </p>
      </div>
      <ul role="list" class="roll__names">
        {partners.map((partner) => <li>{partner}</li>)}
      </ul>
    </div>
  </Section>

  {/* Delivered training as editorial spreads: the evidence, at a size where
      the rooms and the people in them are legible. */}
  <Section labelledBy="delivered-heading" spacing="loose" reveal>
    <h2 id="delivered-heading">Training we have delivered</h2>
    <p class="band-note">Each of these happened. The photographs are from the sessions.</p>

    {/* No `href` on these rows: they are records of sessions that happened,
        not links to anywhere. Pointing them at the join form would be a false
        affordance: the reader clicks the Matatu Film Lab and gets a form. */}
    <div class="features">
      {
        delivered.map((item, index) => (
          <FeatureRow
            number={String(index + 1).padStart(2, '0')}
            title={item.title}
            description={item.detail}
            image={item.media.image}
            alt={item.media.alt}
            reversed={index % 2 === 1}
            headingLevel={3}
          />
        ))
      }
    </div>
  </Section>

  <EstablishingShot
    image={cohort.image}
    alt={cohort.alt}
    headingId="cta-heading"
    heading="Training is a membership benefit"
    standfirst="Every session above was open to WUFPA members. Joining is how a filmmaker in any of the six sub-regions gets access to the next one."
    objectPosition="center 40%"
  >
    <Button href="/membership/join/" size="lg">Become a member</Button>
  </EstablishingShot>

  <Section labelledBy="related-heading" variant="subtle" container="reading">
    <h2 id="related-heading" class="u-visually-hidden">Related work</h2>
    <RelatedLinks
      heading="Related work"
      links={[
        {
          href: '/programmes/competitions/',
          label: 'Competitions and awards',
          reason: 'Several of these master classes prepared members for the UCC competition.',
        },
        {
          href: '/programmes/international/',
          label: 'International exposure',
          reason: 'Where training turns into festival delegations.',
        },
        {
          href: '/partners/',
          label: 'Our partners',
          reason: 'The institutions that deliver this training with us.',
        },
      ]}
    />
  </Section>
</BaseLayout>

<style>
  .lead {
    margin: 0;
    max-inline-size: var(--measure-narrow);
    font-family: var(--font-body);
    font-size: var(--text-xl);
    line-height: var(--leading-relaxed);
    color: var(--text-heading);
  }

  .band-note {
    margin: var(--space-3) 0 0;
    max-inline-size: var(--measure-narrow);
    font-size: var(--text-lg);
    color: var(--text-secondary);
  }

  /* Partner roll: intro beside the names at width, stacked below it. */
  .roll {
    display: grid;
    gap: var(--space-6);
  }

  .roll__names {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .roll__names li {
    padding-block: var(--space-3);
    border-block-start: 1px solid var(--line-default);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
    color: var(--text-heading);
  }

  @media (min-width: 56rem) {
    .roll {
      grid-template-columns: 1fr 1.1fr;
      gap: var(--space-8);
      align-items: start;
    }

    .roll__names li {
      font-size: var(--text-xl);
    }
  }

  .features {
    display: grid;
    gap: var(--space-9);
    margin-block-start: var(--space-7);
  }

  @media (min-width: 56rem) {
    .features {
      gap: calc(var(--space-8) * 1.6);
    }
  }
</style>
