---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/layout/Section.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import Prose from '../../components/layout/Prose.astro';
import Grid from '../../components/layout/Grid.astro';
import Figure from '../../components/media/Figure.astro';
import RelatedLinks from '../../components/content/RelatedLinks.astro';
import Button from '../../components/primitives/Button.astro';
import { getPhoto } from '../../lib/photos';
import { meta } from '../../lib/page-meta';

/**
 * /programmes/international/ — docs/04 § 6.7, verbatim.
 *
 * Experience intent: "Encouraged · Included · Empowered." The mechanism is
 * the delegate accreditation photographs — named WUFPA members holding
 * credentials at an international market. That is a more specific claim than
 * any sentence about ambition.
 *
 * Reference: A24, cinematic confidence only — one wide image, generous space,
 * no crowding.
 *
 * The CTA here is "Support this work", per docs/04 § 6.7, not "Become a
 * member": travel support is named in [P3] as a current association need, so
 * the honest ask on this page is funding rather than membership.
 */

const page = meta('/programmes/international/');
const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'What we do', href: '/programmes/' },
  { label: 'International exposure' },
];

const hero = getPhoto('programmes/international/kigali-content-market-2023-panel.jpeg');

const kigali = [
  'programmes/international/kigali-delegate-card-katabazi-george.jpeg',
  'programmes/international/kigali-delegate-card-kamugisha-william.jpeg',
  'programmes/international/mashariki-film-festival-banner-2023.jpeg',
].map((file) => getPhoto(file));
---

<BaseLayout title={page.title} description={page.description} crumbs={crumbs}>
  <PageHeader
    title="International exposure"
    standfirst="WUFPA takes its members out of the region so they come back with more than they left with."
    crumbs={crumbs}
  />

  <Section spacing="compact">
    <Figure
      image={hero.image}
      alt={hero.alt}
      purpose="hero"
      ratio="auto"
      variant="wide"
      sizes="(min-width: 64rem) 60rem, 100vw"
      {...hero.caption ? { caption: hero.caption } : {}}
      {...hero.dateNote ? { dateNote: hero.dateNote } : {}}
    />
  </Section>

  <Section labelledBy="delegations-heading" container="narrow" reveal>
    <h2 id="delegations-heading">Delegations</h2>
    <Prose>
      <p>
        WUFPA has led delegations of producers to benchmark and participate in international
        film festivals — including the African Mashariki Film Festival and the Zanzibar
        International Film Festival — exposing members to global trends, networking
        opportunities and collaborative projects.
      </p>
      <p>
        In November 2023, a WUFPA delegation attended the Kigali International Content Market
        in Kigali, Rwanda.
      </p>
    </Prose>
  </Section>

  <Section labelledBy="kigali-heading" variant="subtle" reveal>
    <h2 id="kigali-heading">Kigali International Content Market, 2023</h2>
    <Grid min="16rem" gap={6} class="kigali">
      {
        kigali.map((photo) => (
          <Figure
            image={photo.image}
            alt={photo.alt}
            purpose="card"
            ratio="auto"
            variant="grid-item"
            sizes="(min-width: 64rem) 20rem, 100vw"
            {...photo.caption ? { caption: photo.caption } : {}}
            {...photo.dateNote ? { dateNote: photo.dateNote } : {}}
          />
        ))
      }
    </Grid>
  </Section>

  <Section labelledBy="cta-heading" container="narrow" reveal>
    <h2 id="cta-heading">What this needs</h2>
    <Prose>
      <p>
        Travel support and exchange programmes for festivals, labs and residencies are among
        the association’s current needs. Sponsoring a delegate is one of the most direct ways
        to put a Western Ugandan filmmaker in an international room.
      </p>
    </Prose>
    <div class="actions">
      <Button href="/support/">Support this work</Button>
      <Button href="/membership/join/" variant="tertiary">Become a member</Button>
    </div>

    <RelatedLinks
      heading="Related work"
      links={[
        {
          href: '/programmes/training/',
          label: 'Training and master classes',
          reason: 'The groundwork that makes a delegation worth sending.',
        },
        {
          href: '/programmes/distribution/',
          label: 'Distribution and market access',
          reason: 'What a content market is ultimately for.',
        },
        {
          href: '/support/',
          label: 'Support WUFPA',
          reason: 'Travel support is a named association need.',
        },
      ]}
    />
  </Section>
</BaseLayout>

<style>
  .kigali {
    margin-block-start: var(--space-6);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-block-start: var(--space-6);
  }
</style>
