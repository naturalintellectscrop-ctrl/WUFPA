---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/layout/Section.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import Prose from '../../components/layout/Prose.astro';
import Sidebar from '../../components/layout/Sidebar.astro';
import Stack from '../../components/layout/Stack.astro';
import Grid from '../../components/layout/Grid.astro';
import KeyFacts from '../../components/content/KeyFacts.astro';
import Disclosure from '../../components/content/Disclosure.astro';
import RelatedLinks from '../../components/content/RelatedLinks.astro';
import Button from '../../components/primitives/Button.astro';
import { meta } from '../../lib/page-meta';
import type { Fact } from '../../lib/types';

/**
 * /about/ — WUFPA-034.
 *
 * Experience formula: docs/22 § /about/. Read it before changing this page.
 * Copy is verbatim from docs/04 § 4; every fact traces to [P1] or [P2] via
 * docs/02 § 6. Nothing on this page is written by the agency.
 *
 * NO VALUES SECTION, DELIBERATELY. docs/02 § 5.3 proposes five values but no
 * supplied source states them, and docs/04 § 4.5 is explicit: omit until WUFPA
 * confirms. An About page without a values list is normal; one with invented
 * values is the exact failure docs/20 exists to prevent.
 *
 * NO PHOTOGRAPH. This is a text-led route (docs/22). The wide column that
 * leaves is answered with white space and a fact rail, not with a decorative
 * band — docs/21 § 2.4 and § 11.
 */

const page = meta('/about/');

/* Every fact here is in docs/02 § 13's approved list. The rail is what makes
   "Trustworthy" a mechanism rather than an adjective (docs/22 § Identity). */
const facts: Fact[] = [
  { label: 'Registered', value: '4 September 2017' },
  { label: 'Legal form', value: 'Company limited by guarantee' },
  { label: 'Status', value: 'Non-profit' },
  { label: 'Head office', value: 'Mbaguta Street, Mbarara Shopping Market, Mbarara City' },
  { label: 'Sub-regions', value: 'Six' },
  { label: 'Production houses', value: 'More than 300' },
];

/* Verbatim from [P1] via docs/02 § 6.1. The two-part shape — a named objective
   and WUFPA's own sentence — is what lets the page be scanned by A1 and read in
   full by A2 without writing it twice. */
const objectives = [
  {
    name: 'Capacity Building',
    text: 'Develop skills in screenwriting, directing, acting, cinematography, editing, and film production among members through workshops, mentorships, and hands-on training.',
  },
  {
    name: 'Cultural Promotion',
    text: 'Use film to preserve and promote the diverse cultures, languages, and traditions of the Western Uganda sub regions.',
  },
  {
    name: 'Advocacy & Networking',
    text: "Represent filmmakers' interests in national and regional platforms and create partnerships with stakeholders in the creative, tourism, and development sectors.",
  },
  {
    name: 'Community Development',
    text: 'Leverage film and performing arts to support developmental programs, civic education, and youth engagement.',
  },
  {
    name: 'Tourism Promotion',
    text: 'Produce culturally themed films that highlight the unique landscapes, histories, and heritage of Western Uganda as a tool for promoting local and international tourism.',
  },
];

/* Verbatim from [P2] via docs/02 § 6.2. Secondary, complete, and tedious for a
   prospective member — which is precisely what a Disclosure is for. */
const constitutionalObjects = [
  'To establish, develop and manage film production studios, film stores and cinemas for the better marketing of film content.',
  'To empower and equip performing artists, producers, directors and technical personnel with modern information technologies, in order to bridge the gap between the local and international motion picture industry.',
  "To establish and administer a fund to support members' welfare, and to invest in projects and financing for members' development activities.",
  'To establish cultural art libraries for the exhibition of film, event performance and photographs, and for social, musical, theatrical and other entertainments.',
  'To develop, conduct and maintain research initiatives for film programme and project planning; and to seek viable partners for development, training, financial support, investment and maintenance of group projects and programmes.',
  "To apply to international bodies, governments, authorities, national bodies, public organisations, corporations, groups or persons for grants, donations, gifts, subscriptions and other assistance in furtherance of the association's objects.",
];

const crumbs = [{ label: 'Home', href: '/' }, { label: 'About WUFPA' }];
---

<BaseLayout
  title={page.title}
  description={page.description}
  crumbs={crumbs}
  pageType="AboutPage"
>
  <PageHeader
    title="About WUFPA"
    standfirst="The Western Uganda Film Producers Association is a non-profit body representing more than 300 film production houses across six sub-regions. This is who we are, why we exist, and how we are held accountable."
    crumbs={crumbs}
  />

  {/* The recomposition described in docs/22: at 1280 the facts move from
      interrupting the narrative to accompanying it. Below the Sidebar's
      content-driven threshold they stack, facts first, so a reader on a phone
      still meets the registration fact before the prose. */}
  <Section labelledBy="introduction-heading">
    <h2 id="introduction-heading" class="u-visually-hidden">Introduction</h2>
    <Sidebar width="19rem" contentMin="55%" gap={8}>
      <aside slot="rail" aria-label="Association facts">
        <KeyFacts facts={facts} />
      </aside>

      <Prose>
        <p>
          The Western Uganda Film Producers Association Limited (WUFPA) is a legally
          registered, non-profit organisation limited by guarantee, founded on
          4 September 2017. Headquartered on Mbaguta Street, Mbarara Shopping Market,
          Mbarara City, WUFPA unites film producers, production companies, film groups and
          film guilds across the six sub-regions of Western Uganda: Ankole (Rwizi), Kigezi,
          Rwenzori, Tooro, Bunyoro and Greater Bushenyi.
        </p>
        <p>
          The association started with 14 companies and groups. It now comprises more than
          300 film production houses from across Western Uganda, each with over 35 members.
        </p>
      </Prose>
    </Sidebar>
  </Section>

  {/* Vision and mission are pull-quotes rather than body copy: they are WUFPA's
      own words about itself, and setting them apart is how the page shows that
      rather than asserting it. Weight and measure do the work — no colour,
      no border (docs/21 § 10). */}
  <Section labelledBy="vision-heading" variant="subtle" container="narrow" reveal>
    <h2 id="vision-heading">Our vision</h2>
    <blockquote class="statement">
      <p>
        To be a leading regional force in empowering filmmakers and using film as a medium
        for social transformation, cultural preservation, and economic development in
        Western Uganda.
      </p>
    </blockquote>
  </Section>

  <Section labelledBy="mission-heading" container="narrow" reveal>
    <h2 id="mission-heading">Our mission</h2>
    <blockquote class="statement">
      <p>
        To unite, train, and support film producers and creatives in Western Uganda to
        create high-quality films that address key social issues, promote cultural heritage,
        and contribute to sustainable community development.
      </p>
    </blockquote>
    <Prose class="mission-detail">
      <p>
        We nurture filmmakers capable of writing, directing, producing and acting in
        socially impactful and culturally rooted films, using cinema as a tool for
        education, cultural tourism and community development.
      </p>
    </Prose>
  </Section>

  <Section labelledBy="objectives-heading" variant="subtle" reveal>
    <h2 id="objectives-heading">Our core objectives</h2>
    <p class="standfirst">Five objectives, as WUFPA states them.</p>

    <Grid min="19rem" gap={6} class="objectives">
      {
        objectives.map((objective) => (
          <article class="objective">
            <h3 class="objective__name">{objective.name}</h3>
            <p class="objective__text">{objective.text}</p>
          </article>
        ))
      }
    </Grid>

    {/* Progressive disclosure serves A1 (prospective member) and A2
        (institutional partner) without a compromise that serves neither —
        docs/04 § 4.4. */}
    <Disclosure summary="Our full constitutional objects" class="objects">
      <p class="objects__intro">
        The six objects for which the association is constituted, as registered.
      </p>
      <Stack as="ol" gap={4} class="objects__list">
        {constitutionalObjects.map((object) => <li>{object}</li>)}
      </Stack>
    </Disclosure>
  </Section>

  <Section labelledBy="accountable-heading" container="narrow" reveal>
    <h2 id="accountable-heading">How we are held accountable</h2>
    <Prose>
      <p>
        WUFPA is governed by an executive committee and a board of trustees, and its
        registration, constitution and governing documents are matters of public record. The
        pages below set out the structure, the people, and the legal position in full.
      </p>
    </Prose>
    <div class="actions">
      <Button href="/about/governance/" variant="secondary">How WUFPA is governed</Button>
      <Button href="/about/legal/" variant="tertiary">Legal status and registration</Button>
    </div>

    <RelatedLinks
      heading="Elsewhere on this site"
      links={[
        { href: '/about/history/', label: 'Our story', reason: 'From 14 companies in 2017 to more than 300 today.' },
        { href: '/programmes/', label: 'Our programmes', reason: 'The six areas the objectives above turn into work.' },
        { href: '/membership/', label: 'Membership', reason: 'Who can join, and what membership provides.' },
      ]}
    />
  </Section>
</BaseLayout>

<style>
  /* Statement — vision and mission. Serif, larger, and set to a narrower
     measure than surrounding prose so it reads as WUFPA speaking rather than as
     the site describing WUFPA. No quotation marks: the <blockquote> carries the
     semantics and decorative glyphs would be exactly the ornament docs/21 § 2.4
     rules out. */
  .statement {
    margin: 0;
    max-inline-size: var(--measure-narrow);
    font-family: var(--font-body);
    font-size: var(--text-xl);
    line-height: var(--leading-relaxed);
    color: var(--text-heading);
  }

  .statement p {
    margin: 0;
  }

  .mission-detail {
    margin-block-start: var(--space-6);
  }

  .objectives {
    margin-block-start: var(--space-6);
  }

  /* Border-inline-start, not a card. A box around each objective would add five
     containers to a page whose argument is the text inside them; a rule is
     enough to group and costs no enclosure (docs/21 § 10 — spacing before
     borders, and where a border is used, one). */
  .objective {
    padding-inline-start: var(--space-4);
    border-inline-start: 2px solid var(--line-accent);
  }

  .objective__name {
    margin: 0 0 var(--space-2);
    font-size: var(--text-lg);
  }

  .objective__text {
    margin: 0;
    color: var(--text-body);
  }

  .objects {
    margin-block-start: var(--space-8);
  }

  .objects__intro {
    margin: 0 0 var(--space-4);
    color: var(--text-secondary);
  }

  .objects__list {
    max-inline-size: var(--measure-prose);
    padding-inline-start: var(--space-5);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    margin-block-start: var(--space-6);
  }
</style>
