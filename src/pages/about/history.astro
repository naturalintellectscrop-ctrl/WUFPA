---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/layout/Section.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import Prose from '../../components/layout/Prose.astro';
import Timeline from '../../components/content/Timeline.astro';
import EstablishingShot from '../../components/content/EstablishingShot.astro';
import StatementBand from '../../components/content/StatementBand.astro';
import RelatedLinks from '../../components/content/RelatedLinks.astro';
import { getPhoto } from '../../lib/photos';
import { meta } from '../../lib/page-meta';
import type { TimelineEntry } from '../../lib/types';

/**
 * /about/history/ — the reconciled timeline from docs/02 § 3.
 *
 * Experience intent: an institution with a past is harder to dismiss than one
 * with a plan. The mechanism is the timeline itself — dated, sourced, and
 * long enough that its length is the argument.
 *
 * ROUGHLY A THIRD OF WUFPA'S ACTIVITY CARRIES NO DATE. Those entries are
 * passed to Timeline without a `dateLabel`, which groups them under "Date not
 * recorded" rather than interleaving them at a guessed position. Publishing a
 * guessed year would be a fabrication that no reader could detect, which is
 * exactly why the component makes the honest path the easy one.
 *
 * Reference: British Film Institute — institutional credibility only.
 */

const page = meta('/about/history/');
const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'About WUFPA', href: '/about/' },
  { label: 'Our story' },
];

const pioneers = getPhoto('history/wufpa-pioneers-2017.jpeg');

/* docs/02 § 3, verbatim. `date` is the machine-readable value; `dateLabel` is
   what a reader sees. Entries with neither are grouped as undated. */
const entries: TimelineEntry[] = [
  {
    date: '2017-09-04',
    dateLabel: '4 September 2017',
    title: 'WUFPA is registered',
    description:
