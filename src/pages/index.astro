---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/layout/Section.astro';
import CinematicHero from '../components/content/CinematicHero.astro';
import Ledger from '../components/content/Ledger.astro';
import IndexList from '../components/content/IndexList.astro';
import FrameSequence from '../components/content/FrameSequence.astro';
import EstablishingShot from '../components/content/EstablishingShot.astro';
import StatementBand from '../components/content/StatementBand.astro';
import Button from '../components/primitives/Button.astro';
import { getPhoto } from '../lib/photos';
import { site } from '../lib/site-config';
import { meta } from '../lib/page-meta';
import type { Stat } from '../lib/types';

/**
 * Homepage — docs/04 § 3.
 *
 * ART DIRECTION NOTE, because the composition here is deliberate and a future
 * editor should know what it is protecting.
 *
 * An earlier pass rendered all seven bands identically: heading, standfirst,
 * grid of cards, tertiary button, on an alternating light/tinted background.
 * That is the arrangement every site template produces, and it failed WUFPA
 * on two specific counts. It made the group photographs — twenty to a hundred
 * real people, the most persuasive asset the association owns — into 30rem
 * thumbnails. And it gave the six programmes, six sub-regions and six
 * activity records the same visual weight and the same shape, so the page
 * read as three interchangeable card grids rather than as an argument.
 *
 * THE RHYTHM NOW RUNS: cinematic hero → typographic ledger → editorial
 * statement → numbered index → full-bleed establishing shot → film strip →
 * dark statement band → partner roll → dark ask. No two consecutive sections
 * share a layout, a background treatment or a height. Consistency comes from the type scale, the spacing scale and
 * the single accent — not from repeating one section shape (docs/21 § 12).
 *
 * The opening is a full-viewport photograph under a measured scrim, with the
 * headline set into its lower third. That is the one arrangement a film
 * association's homepage has to earn: the page shows a room full of members
 * before it makes a claim about them. The ledger that follows sits tight
 * beneath it with no background change, so the figures read as the hero's own
 * footing rather than as the next section down.
 *
 * The three compositions that carry it are drawn from WUFPA's own material
 * rather than applied to it: the strip of dated frames is the film strip in
 * the association's mark, the numbered index is how a festival programme sets
 * its contents, and the establishing shot is the documentary convention for
 * showing where a scene takes place.
 *
 * Every fact and every line of copy is verbatim from docs/04 § 3. The H1 is
 * documented as deliberately literal (docs/04 § 3.1) and is not to be made
 * poetic.
 */

const { title, description } = meta('/');

const hero = getPhoto('regions/tooro/sensitisation-workshop-tooro-obukama-bwa-tooro.jpeg');

/* The establishing shot for "where we work". The Bunyoro banner photograph is
   chosen over the Tooro one already used by the hero: it is a forty-person
   group in front of the WUFPA Bunyoro Region sign, so the image states the
   sub-region structure the section is about. */
const regionsShot = getPhoto('regions/bunyoro/sensitisation-workshop-bunyoro-2022-banner.jpeg');

/* The membership ask sits over the AGM photograph — the whole association in
   one frame, which is the argument the section is making. */
const membershipShot = getPhoto('governance/wufpa-agm-2023.jpeg');

// docs/04 § 3.2. The "10,500 creatives" figure is deliberately excluded: it is
// 300 × 35, an estimate rather than a count (audit finding X13), and belongs
// in body copy phrased as such, never in a ledger that reads as hard numbers.
const stats: Stat[] = [
  { figure: '300+', label: 'film production houses', source: '[P1]' },
  { figure: '6', label: 'sub-regions of Western Uganda', source: '[P1]' },
  { figure: '10', label: 'film guilds, from directors to gaffers', source: '[P7]' },
  { figure: '2017', label: 'registered with URSB as a non-profit', source: '[P1] [P4]' },
];

// docs/04 § 6.1 — the six programme cards, copy verbatim.
const programmes = [
  {
    title: 'Training & Capacity Building',
    href: '/programmes/training/',
    description:
      'Workshops, master classes and mentorship in screenwriting, directing, acting, cinematography, editing and production — delivered with UCC, UNESCO’s national commission, US Mission Uganda and others.',
  },
  {
    title: 'Advocacy, Rights & Anti-Piracy',
    href: '/programmes/advocacy/',
    description:
      'We campaign for filmmakers’ copyright, take that campaign to the streets, and press for film to be taught in Uganda’s schools.',
  },
  {
    title: 'The Kibanda Initiative',
    href: '/programmes/kibanda/',
    description:
      'Community film screenings that bring Western Ugandan films to towns, schools and rural communities.',
  },
  {
    title: 'Distribution & Market Access',
    href: '/programmes/distribution/',
    description:
      'We organised the region’s film distributors, and members’ films now air on five regional broadcasters.',
  },
  {
    title: 'Competitions & Awards',
    href: '/programmes/competitions/',
    description:
      'We persuaded the Uganda Communications Commission to create a regional film competition, and we run the Western Uganda Film Awards Gala.',
  },
  {
    title: 'International Exposure',
    href: '/programmes/international/',
    description:
      'Delegations to Zanzibar, Kigali and beyond, so our members meet the industry outside Uganda.',
  },
];

/* docs/04 § 3.6 — "Not a summary — the work itself." Six dated items, each
   with the photograph of that specific event. The undated march is last and
   says so rather than being given a guessed date. */
const evidence = [
  {
    date: '2022',
    copy: 'Signed a memorandum of understanding with Sky TV, Mbarara City.',
    photo: 'programmes/distribution/sky-tv-mbarara-mou-2022-group.jpeg',
  },
  {
    date: '2023',
    copy: 'Trained members with MTN YoTV on how to earn from film content.',
    photo: 'programmes/training/mtn-yotv-monetisation-workshop-2023.jpeg',
  },
  {
    date: 'November 2023',
    copy: 'Took a delegation to the Kigali International Content Market.',
    photo: 'programmes/international/kigali-content-market-2023-panel.jpeg',
  },
  {
    date: '2024',
    copy: 'Hosted the Matatu Film Lab with Film Possible and US Mission Uganda.',
    photo: 'programmes/training/matatu-film-lab-training-room-2024.jpeg',
  },
  {
    date: 'October 2025',
    copy: 'Members received the WUFM SACCO certificate in Mbarara City.',
    photo: 'sacco/wufm-sacco-certificate-presentation-2025.jpeg',
  },
  {
    date: 'Date not recorded',
    copy: 'Marched through Mbarara for filmmakers’ copyright, with UCC, URSB and the Media Council.',
    photo: 'programmes/advocacy/together-against-piracy-banner-mbarara.jpeg',
  },
].map((item) => {
  const photo = getPhoto(item.photo);
  return { date: item.date, copy: item.copy, image: photo.image, alt: photo.alt };
});

/* docs/04 § 7.1 — the per-region opening lines are the only region-specific
   prose on the site. Reused as the establishing shot's list so the homepage
   and the region pages cannot drift apart. */
const regions = [
  { label: 'Ankole (Rwizi)', note: 'Where WUFPA began, and where its head office stands' },
  { label: 'Kigezi', note: 'One of the two sub-regions that founded WUFPA in 2017' },
  { label: 'Rwenzori', note: 'Home to WUFPA’s current Vice President' },
  { label: 'Tooro', note: 'Sensitisation workshop hosted at Obukama bwa Tooro' },
  { label: 'Bunyoro', note: 'Sensitisation film workshop across the region, 2022' },
  { label: 'Greater Bushenyi', note: 'Met film producers and actors across the sub-region, 2022' },
];
---

<BaseLayout title={title} description={description}>
  {/* The homepage opens on the photograph at full viewport rather than beside
      a text column. WUFPA is a film association; the first thing the page does
      should be to show a room full of its members, at the size a film company
      shows an image. The split Hero remains the right treatment for section
      openings, where the job is to be read quickly rather than to establish. */}
  <CinematicHero
    eyebrow="Western Uganda Film Producers Association"
    headline="The film industry of Western Uganda has an address"
    standfirst="WUFPA unites more than 300 film production houses across Ankole, Kigezi, Rwenzori, Tooro, Bunyoro and Greater Bushenyi. We train filmmakers, defend their copyright, open markets for their work, and represent them where decisions are made."
    primaryCta={{ label: 'Become a member', href: '/membership/join/' }}
    secondaryCta={{ label: 'See what we do', href: '/programmes/' }}
    image={hero.image}
    alt={hero.alt}
    objectPosition="center 35%"
  />

  {/* The ledger sits tight under the hero with no background change — it reads
      as the hero's own footing rather than as a separate band. */}
  <Section labelledBy="proof-heading" spacing="compact">
    <h2 id="proof-heading" class="u-visually-hidden">WUFPA in figures</h2>
    <Ledger stats={stats} note="Figures as recorded in the WUFPA association profile, 2025." />
  </Section>

  {/* WHO WE ARE — an editorial statement, not a prose block in a tinted box.
      The founding year is set as a graphic date marker at display scale and
      the narrative runs beside it, so the section has a composition of its own
      rather than the site's default centred column. */}
  <Section labelledBy="who-we-are-heading" spacing="loose" reveal>
    <div class="statement">
      <p class="statement__marker" aria-hidden="true">2017</p>

      <div class="statement__body">
        {/* The one headline on the homepage that carries the whole argument,
            so it gets the title-card rise rather than the standard band fade. */}
        <div class="reveal reveal--letter">
          <h2 id="who-we-are-heading" class="statement__heading">
            We are the association Western Uganda’s filmmakers built for themselves
          </h2>
        </div>

        <p class="statement__lead">
          In 2017, fourteen production companies from Ankole and Kigezi registered an
          association. They were tired of an industry whose training, funding, buyers and
          policy conversations all happened in Kampala — and of watching their films copied
          and sold without permission.
        </p>

        <div class="statement__rest">
          <p>
            Eight years later WUFPA is more than 300 production houses, organised into ten
            craft guilds, with coordinators in six sub-regions and districts from Kabale to
            Kagadi.
          </p>
          <p>
            We are a non-profit company limited by guarantee. We do not make films ourselves.
            We make it possible for our members to.
          </p>
          <p class="statement__action">
            <Button href="/about/" variant="tertiary">About WUFPA</Button>
          </p>
        </div>
      </div>
    </div>
  </Section>

  {/* WHAT WE DO — a numbered index, not six cards. */}
  <Section labelledBy="what-we-do-heading" variant="subtle" reveal>
    <div class="band-head">
      <h2 id="what-we-do-heading">Six ways we work for our members</h2>
      <p class="band-head__note">Training, rights, audiences, markets, money and recognition.</p>
    </div>
    <IndexList items={programmes} class="programmes-index" />
    <p class="band-action">
      <Button href="/programmes/" variant="tertiary">All our programmes</Button>
    </p>
  </Section>

  {/* WHERE WE WORK — full-bleed. The photograph is the section; the six names
      sit over it at width and beneath it on a phone. */}
  <EstablishingShot
    image={regionsShot.image}
    alt={regionsShot.alt}
    headingId="where-we-work-heading"
    heading="From Kabale to Kagadi"
    standfirst="WUFPA covers the six sub-regions of Western Uganda. Each has its own coordinator, secretary and treasurer, and district coordinators working alongside them."
    items={regions}
    objectPosition="center 40%"
  >
    <Button href="/regions/" variant="inverse">Find your sub-region</Button>
  </EstablishingShot>

  {/* EVIDENCE — the film strip. This is the page's signature composition. */}
  <Section labelledBy="evidence-heading" spacing="loose" reveal>
    <div class="band-head">
      <h2 id="evidence-heading">Eight years on the record</h2>
      <p class="band-head__note">Not a summary — the work itself.</p>
    </div>
    <FrameSequence frames={evidence} label="WUFPA activity record, 2022 to 2025" />
    <p class="band-action">
      <Button href="/impact/" variant="tertiary">See our impact</Button>
    </p>
  </Section>

  {/* The pause. After the record — six dated frames of evidence — the page
      stops and says the one thing WUFPA says about itself, then goes on. Dark,
      centred, nothing else in the band: a cut to black between movements.
      Used once on this page and nowhere else on it. The line is WUFPA's own
      organisational strapline from [P3], not a headline written to sound
      like one. */}
  <StatementBand
    statement={site.strapline}
    source="The WUFPA strapline"
    headingId="strapline-heading"
    label="What WUFPA stands for"
  />

  {/* PARTNERS — a typographic roll. Names at scale, no boxes, no logos
      (⟦Q10⟧ — written permission not yet obtained). */}
  <Section labelledBy="partners-heading" variant="subtle" reveal>
    <div class="partners">
      <div class="partners__intro">
        <h2 id="partners-heading">We do not work alone</h2>
        <p class="band-head__note">
          WUFPA’s training, competitions and campaigns are delivered with national and
          international partners.
        </p>
        <p class="band-action">
          <Button href="/partners/" variant="tertiary">Our partners</Button>
        </p>
      </div>

      <ul role="list" class="partners__roll">
        <li>Uganda Communications Commission</li>
        <li>UNATCOM for UNESCO</li>
        <li>US Mission Uganda</li>
        <li>Film Possible</li>
        <li>Alliance Française</li>
        <li>Goethe-Zentrum</li>
        <li>Uganda Film Network</li>
        <li>National Producers Guild of Uganda</li>
      </ul>
    </div>
  </Section>

  {/* MEMBERSHIP — the ask, over the whole association in one frame. */}
  <EstablishingShot
    image={membershipShot.image}
    alt={membershipShot.alt}
    headingId="membership-heading"
    heading="If you make films in Western Uganda, this is your association"
    standfirst="Membership is open to production companies, community film groups, guilds and individual creatives — writers, directors, actors, editors, camera operators, sound recordists, animators, costume and make-up artists, and gaffers."
    objectPosition="center 35%"
    class="membership-shot"
  >
    <div class="membership__ctas">
      <Button href="/membership/join/" size="lg">Become a member</Button>
      <Button href="/membership/" variant="inverse" size="lg">What members get</Button>
    </div>
  </EstablishingShot>
</BaseLayout>

<style>
  /* ── Shared band furniture ────────────────────────────────────────────
     A heading and its note, then the composition, then one action. Kept
     deliberately light: the sections differ by composition, not by chrome. */
  .band-head {
    margin-block-end: var(--space-7);
  }

  .band-head__note {
    margin: var(--space-3) 0 0;
    max-inline-size: var(--measure-narrow);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
    font-weight: var(--weight-regular);
  }

  .band-action {
    margin: var(--space-7) 0 0;
  }

  .programmes-index {
    margin-block-start: var(--space-7);
  }

  /* ── Who we are ───────────────────────────────────────────────────────
     The year is a graphic element, not a heading: it is aria-hidden because
     "2017" is already stated in the first sentence, and announcing it twice
     tells a screen-reader user nothing new. */
  .statement {
    display: grid;
    gap: var(--space-5);
  }

  .statement__marker {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: var(--weight-black);
    line-height: 0.9;
    letter-spacing: var(--tracking-tight);
    color: var(--line-default);
  }

  .statement__heading {
    margin: 0 0 var(--space-5);
    max-inline-size: 20ch;
    font-size: var(--text-3xl);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
  }

  /* The opening paragraph is set larger and in the body serif — it is the
     one WUFPA sentence a visitor is most likely to read in full, so it is
     given the weight of a standfirst rather than the weight of body copy. */
  .statement__lead {
    margin: 0;
    max-inline-size: var(--measure-narrow);
    font-family: var(--font-body);
    font-size: var(--text-xl);
    line-height: var(--leading-relaxed);
    color: var(--text-heading);
  }

  .statement__rest {
    margin-block-start: var(--space-6);
    max-inline-size: var(--measure-prose);
    color: var(--text-body);
  }

  .statement__rest p {
    margin: 0 0 var(--space-4);
  }

  .statement__action {
    margin: var(--space-2) 0 0;
  }

  @media (min-width: 56rem) {
    /* The marker moves into its own column and grows, so the section reads
       as a dated entry rather than as a centred article. */
    .statement {
      grid-template-columns: minmax(6rem, 10rem) 1fr;
      gap: var(--space-8);
      align-items: start;
    }

    .statement__marker {
      font-size: clamp(4rem, 8vw, 7rem);
      /* Optically aligns the numeral's cap with the heading's. */
      margin-block-start: -0.08em;
    }

    /* Body copy indents past the lead, so the eye steps down a level rather
       than reading one uniform column. */
    .statement__rest {
      padding-inline-start: var(--space-6);
      border-inline-start: 2px solid var(--line-accent);
    }
  }

  /* ── Partners ─────────────────────────────────────────────────────────
     Names set at scale in the display face. No logos (⟦Q10⟧), no boxes, no
     grid of equal tiles — a roll of institution names IS the credential. */
  .partners {
    display: grid;
    gap: var(--space-8);
  }

  .partners__roll {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--line-subtle);
    border-radius: var(--radius-control);
    background-color: var(--surface-subtle);
  }

  .partners__roll li {
    padding-block: var(--space-4);
    padding-inline: var(--space-5);
    border-block-start: 1px solid var(--line-subtle);
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
    color: var(--text-heading);
  }

  .partners__roll li:first-child {
    border-block-start: none;
    border-radius: var(--radius-control) var(--radius-control) 0 0;
  }

  .partners__roll li:last-child {
    border-radius: 0 0 var(--radius-control) var(--radius-control);
  }

  .partners__intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  @media (min-width: 56rem) {
    .partners {
      grid-template-columns: 1fr 1.1fr;
      gap: var(--space-8);
      align-items: start;
    }

    .partners__roll {
      border: none;
      background-color: transparent;
      border-block-start: 1px solid var(--line-default);
    }

    .partners__roll li {
      font-size: var(--text-lg);
      padding-block: var(--space-5);
      padding-inline: var(--space-6);
      border-block-start: 1px solid var(--line-default);
      background-color: transparent;
      border-radius: 0;
    }

    .partners__roll li:first-child {
      border-block-start: none;
      border-radius: 0;
    }

    .partners__roll li:last-child {
      border-radius: 0;
    }
  }

  /* ── Membership ───────────────────────────────────────────────────────
     A little more height than the regions shot: this is the page's closing
     frame and the last thing a visitor sees before the footer. */
  .membership-shot {
    --shot-min-height: min(90vh, 50rem);
  }

  .membership__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
