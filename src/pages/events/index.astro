---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/layout/Section.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import EntityCard from '../../components/content/EntityCard.astro';
import { meta } from '../../lib/page-meta';
import { eventSchema } from '../../lib/structured-data';
import { derive, formatDates, sortForDisplay } from '../../lib/events';

/**
 * Events index: upcoming and past, split by date-derived status.
 *
 * PAST EVENTS ARE AN ASSET, NOT CLUTTER (docs/09 § 9.4). They stay published
 * permanently: they are the evidence base for the programme pages, and an
 * association that deletes its past looks younger than it is: WUFPA's age is
 * one of its strongest arguments.
 *
 * Nothing here reads a hand-typed status. Everything comes from `derive()`, so
 * an event cannot describe a past date as upcoming.
 *
 * Source: docs/04 § 13.3 · docs/09 § 9.2 · WUFPA-052
 */

const all = await getCollection('events');

/* One `now` for the whole build. Deriving per-event from `new Date()` could
   straddle midnight during a long build and produce a page set that disagrees
   with itself. */
const now = new Date();
const { upcoming, past } = sortForDisplay(
  all.map((e) => ({ ...e, ...e.data })),
  now,
);

const { title, description } = meta('/events/');
const base = Astro.site ?? new URL('https://wufpa.example.org');

/* Schema for every event VISIBLE on this page. `eventSchema()` returns null
   for an undated event rather than inventing a startDate, and `graph()` drops
   the nulls. */
const schemas = [...upcoming, ...past].map((event) =>
  eventSchema({
    url: new URL(`/events/${event.id}/`, base).href,
    base,
    name: event.title,
    status: derive(event, now).schemaStatus,
    ...(event.startDate ? { startDate: event.startDate } : {}),
    ...(event.endDate ? { endDate: event.endDate } : {}),
    ...(event.venue ? { venue: event.venue } : {}),
    ...(event.district ? { district: event.district } : {}),
  }),
);

const card = (event: (typeof upcoming)[number]) => {
  const status = derive(event, now);
  return {
    title: event.title,
    href: `/events/${event.id}/`,
    eyebrow: formatDates(event),
    tags: status.badge ? [status.badge] : [],
    meta: event.venue ? [{ label: 'Venue', value: event.venue }] : [],
  };
};
---

<BaseLayout
  title={title}
  description={description}
  crumbs={[{ label: 'Events' }]}
  pageType="CollectionPage"
  schemas={schemas}
>
  <PageHeader
    title="Events"
    standfirst="Workshops, screenings, competitions and meetings across the six sub-regions."
    crumbs={[{ label: 'Events' }]}
  />

  <Section labelledBy="upcoming-heading">
    <h2 id="upcoming-heading">Upcoming events</h2>

    {
      upcoming.length === 0 ? (
        /* Verbatim from docs/04 § 13.3. Honest, and does not make the site
           look abandoned, which "No events" alone would. */
        <p class="empty">
          No events are scheduled at the moment. Past events are below, and new events are
          announced in our <a href="/news/">news</a>.
        </p>
      ) : (
        <ul role="list" class="grid event-grid">
          {upcoming.map((event) => (
            <li>
              <EntityCard variant="event" {...card(event)} />
            </li>
          ))}
        </ul>
      )
    }
  </Section>

  {
    past.length > 0 && (
      <Section variant="subtle" labelledBy="past-heading">
        <h2 id="past-heading">Past events</h2>
        <p class="section-note">
          WUFPA's events stay published permanently: they are the record of what the
          association has done.
        </p>

        <ul role="list" class="grid event-grid">
          {past.map((event) => (
            <li>
              <EntityCard variant="event" {...card(event)} />
            </li>
          ))}
        </ul>
      </Section>
    )
  }
</BaseLayout>

<style>
  /* Columns come from the intrinsic `.grid` primitive, not a breakpoint here
     (WUFPA-015/052). The 40rem media query this replaces asked the viewport how
     wide the list was; `--grid-min` asks the container, which is the same
     distinction docs/21 section 12 draws between recomposing and resizing. */
  .event-grid {
    --grid-min: 18rem;
    gap: var(--space-6);
    margin-block-start: var(--space-6);
    padding: 0;
    list-style: none;
  }

  .empty,
  .section-note {
    color: var(--text-secondary);
  }
</style>
