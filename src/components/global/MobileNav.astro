---
import Button from '../primitives/Button.astro';
import Icon from '../primitives/Icon.astro';
import Disclosure from '../content/Disclosure.astro';
import { primaryNav, becomeAMember } from '../../lib/nav-config';

/**
 * MobileNav: full navigation on small screens (docs/08 section 4).
 *
 * Self-contained: renders both its own trigger and its own panel, per the
 * component's documented anatomy ("Trigger button → full-screen panel →
 * accordion sections → pinned CTA"). SiteHeader composes this rather than
 * hand-rolling a hamburger of its own.
 *
 * The prototype's mobile menu had no accessible name (a bare "☰"), no
 * aria-expanded, no aria-controls, no focus trap, no Escape handling and no
 * focus return, unusable by keyboard, confusing by screen reader (X22).
 * Every one of those is addressed here or in src/scripts/mobile-nav.ts.
 *
 * VISIBLE BY DEFAULT, JS OPTS IN TO THE DIALOG BEHAVIOUR: the same contract
 * src/scripts/reveal.ts establishes: "Content is visible by default. This
 * script opts in to [hiding it], and only AFTER [it] has successfully
 * attached." Concretely: the panel here has no `hidden` attribute and no
 * `role="dialog"`/`aria-modal` in the server-rendered markup, and the
 * trigger button itself starts `hidden`, there being no javascript-free way
 * to open a closed panel, a trigger that does nothing is worse than no
 * trigger (the exact class of dead-control failure this component exists to
 * fix). `src/scripts/mobile-nav.ts` promotes the panel to a real modal
 * dialog, hides it, and reveals the trigger, ONLY once it has found both
 * elements and wired every listener. A user with JavaScript disabled or
 * blocked simply sees the full navigation as a plain, always-visible list,
 * strictly more usable than a hamburger that opens nothing.
 *
 * ACCORDION, NOT ALWAYS-EXPANDED. Items with children (About, Programmes)
 * render through Disclosure (docs/08 section 21): native <details>/
 * <summary>, so open/close state, keyboard support and screen-reader
 * semantics come for free and it works with JavaScript disabled regardless
 * of the dialog upgrade above. One level only, per docs/08 section 4:
 * Disclosure's own children are plain links, never a second Disclosure.
 *
 * Source: docs/08 section 4 · WUFPA-019
 */

const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath === href || currentPath.startsWith(href);
}
---

<button
  type="button"
  class="mobile-trigger"
  aria-controls="mobile-nav-panel"
  data-mobile-trigger
  hidden
>
  <span data-mobile-icon-open><Icon name="menu" /></span>
  <span data-mobile-icon-close hidden><Icon name="close" /></span>
  <span class="u-visually-hidden" data-mobile-trigger-label>Open menu</span>
</button>

<div id="mobile-nav-panel" class="mobile-nav" aria-label="Primary navigation" data-mobile-panel>
  {/*
    A close control INSIDE the panel, not just the header's trigger. The
    panel is `position: fixed; inset: 0` at `--z-modal` once open, which
    paints over the sticky header at `--z-sticky` underneath it, the
    header's own trigger button is still in the DOM and still reachable by
    keyboard, but is not visible or tappable, which is a real bug a first
    version of this component shipped with (WUFPA-019 follow-up, caught by
    testing the actual rendered page rather than only the built HTML). This
    button starts `hidden` and is revealed by mobile-nav.ts alongside the
    trigger, for the same reason the trigger itself starts hidden: nothing
    to close before JS has wired up how to close it.
  */}
  <button type="button" class="mobile-nav__close" data-mobile-close hidden>
    <Icon name="close" />
    <span class="u-visually-hidden">Close menu</span>
  </button>

  <div class="mobile-nav__scroll" data-mobile-scroll>
    <nav aria-label="Primary">
      <ul role="list" class="mobile-nav__list">
        {
          primaryNav.map((item) =>
            item.children ? (
              <li>
                <Disclosure summary={item.label} class="mobile-nav__disclosure">
                  <ul role="list" class="mobile-nav__sublist">
                    {item.children.map((child) => (
                      <li>
                        <a
                          class="mobile-nav__sublink"
                          href={child.href}
                          aria-current={currentPath === child.href ? 'page' : undefined}
                          data-nav-current="exact"
                        >
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </Disclosure>
              </li>
            ) : (
              <li>
                <a
                  class="mobile-nav__link"
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  data-nav-current="section"
                >
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </nav>
  </div>

  <div class="mobile-nav__cta">
    <Button href={becomeAMember.href} block>{becomeAMember.label}</Button>
  </div>
</div>

<script>
  import '../../scripts/mobile-nav';
</script>

<style>
  .mobile-trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: var(--target-min);
    block-size: var(--target-min);
    background: none;
    border: none;
    color: var(--text-body);
    cursor: pointer;
  }

  .mobile-trigger[hidden] {
    display: none !important;
  }

  .mobile-trigger :global(svg) {
    width: 24px;
    height: 24px;
  }

  @media (min-width: 64rem) {
    .mobile-trigger {
      display: none !important;
    }
  }

  /* Default (no-JS) state: a plain in-flow block, visible, not an overlay,
     see the component comment above. */
  .mobile-nav {
    padding: var(--space-6) var(--gutter);
  }

  .mobile-nav[hidden] {
    display: none !important;
  }

  @media (min-width: 64rem) {
    .mobile-nav {
      display: none !important;
    }
  }

  /* Upgraded to a full-screen dialog only once mobile-nav.ts has confirmed
     it can drive open/close, see the component comment above for why this
     is gated on a script-set class rather than the page-wide `.js` flag
     BaseLayout sets (that only proves an inline script ran, not that this
     module has loaded and wired its listeners yet). Two rows: the
     scrollable link list, and the CTA pinned as a non-shrinking flex child,
     not `position: sticky` inside the scroll container, so it is reachable
     without scrolling regardless of how long the link list ever grows
     (docs/08 section 4). */
  :global(html.js-mobile-nav) .mobile-nav {
    position: fixed;
    inset: 0;
    z-index: var(--z-modal);
    display: flex;
    flex-direction: column;
    padding: 0;
    background-color: var(--surface-page);
  }

  .mobile-nav__close {
    display: none;
  }

  :global(html.js-mobile-nav) .mobile-nav__close:not([hidden]) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    position: absolute;
    inset-block-start: var(--space-4);
    inset-inline-end: var(--gutter);
    inline-size: var(--target-min);
    block-size: var(--target-min);
    background: none;
    border: none;
    color: var(--text-body);
    cursor: pointer;
  }

  .mobile-nav__close :global(svg) {
    width: 24px;
    height: 24px;
  }

  :global(html.js-mobile-nav) .mobile-nav__scroll {
    flex: 1;
    overflow-y: auto;
    padding: calc(var(--target-min) + var(--space-6)) var(--gutter) var(--space-6);
  }

  .mobile-nav__list {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Disclosure draws its own border-block-end, so the rule here only targets
     the plain-link rows to avoid a doubled line between accordion items. */
  .mobile-nav__list > li:has(> .mobile-nav__link) {
    border-block-end: 1px solid var(--line-subtle);
  }

  .mobile-nav__list > li:first-child {
    border-block-start: 1px solid var(--line-subtle);
  }

  .mobile-nav__link {
    display: flex;
    align-items: center;
    padding-block: var(--space-4);
    font-family: var(--font-ui);
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    color: var(--text-body);
    text-decoration: none;
    min-block-size: var(--target-min);
  }

  .mobile-nav__link[aria-current='page'] {
    color: var(--text-accent);
  }

  /* Disclosure's own styling handles the summary row; only the child list
     needs mobile-specific sizing here. */
  .mobile-nav__disclosure :global(summary) {
    font-size: var(--text-lg);
  }

  .mobile-nav__sublist {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin: 0;
    padding-inline-start: var(--space-5);
    list-style: none;
  }

  .mobile-nav__sublink {
    display: block;
    padding-block: var(--space-2);
    font-family: var(--font-ui);
    font-size: var(--text-base);
    color: var(--text-secondary);
    text-decoration: none;
    min-block-size: var(--target-min);
  }

  .mobile-nav__sublink[aria-current='page'] {
    color: var(--text-accent);
    font-weight: var(--weight-semibold);
  }

  .mobile-nav__cta {
    flex: none;
    margin-block-start: var(--space-6);
  }

  :global(html.js-mobile-nav) .mobile-nav__cta {
    margin-block-start: 0;
    padding: var(--space-4) var(--gutter);
    border-block-start: 1px solid var(--line-subtle);
  }
</style>
