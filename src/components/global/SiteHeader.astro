---
import Button from '../primitives/Button.astro';
import PrimaryNav from './PrimaryNav.astro';
import MobileNav from './MobileNav.astro';
import { becomeAMember } from '../../lib/nav-config';
import { site } from '../../lib/site-config';

/**
 * SiteHeader: persistent identity and navigation. Carries the primary CTA.
 *
 * NEVER TRULY TRANSPARENT. The prototype's transparent dark-gradient header
 * sat over bright photography and left nav text unreadable (X17 in a
 * different form): docs/08 section 2 is explicit that a header with no
 * guaranteed contrast floor must never ship again. The scrolled state below
 * is translucent, not transparent — a frosted-glass panel that stays at 90%
 * of --surface-page's own opacity with a blur behind it, so whatever photo or
 * colour is under the header is softened into a wash rather than showing
 * through legibly. That 90% floor is deliberate: it is where the header
 * still reads as "the same solid bar, lightened" rather than as glass a
 * background pattern can defeat. `@supports` gates the effect entirely — a
 * browser without backdrop-filter gets the plain solid header instead of a
 * half-implemented one, never a transparency with nothing behind it to
 * soften.
 *
 * `position: sticky`, not `fixed` with a manually-sized spacer: sticky
 * inherently reserves its own height in document flow, which is what avoids
 * the reflow bug a fixed-position header needs a second element to prevent.
 * The compact-on-scroll transition (72px → 60px, logo scales down) is a
 * smooth CSS transition on a sticky element already pinned to the viewport
 * top by the time it fires, so it never displaces content the reader is
 * looking at.
 *
 * Mobile navigation is its own component (WUFPA-019, docs/08 section 4);
 * MobileNav renders both its trigger and its full-screen dialog panel;
 * SiteHeader just places it in the actions area.
 *
 * No SearchField trigger yet: /search/ is WUFPA-073 and does not exist.
 * Docs/08 section 2 lists it in the header's anatomy, but a search icon that
 * goes nowhere is exactly the kind of dead control this rebuild exists to
 * remove. Add it back when WUFPA-073 lands.
 *
 * Source: docs/08 sections 1–3 · docs/05 section 3.1 · WUFPA-018, WUFPA-019
 */
---

<div id="scroll-sentinel" aria-hidden="true"></div>

<header class="site-header" data-site-header transition:persist="site-header">
  <div class="container site-header__bar">
    <a class="site-header__logo" href="/" aria-label={`${site.shortName}, home`}>
      <img
        src="/wufpa_oficial_logo.jpeg"
        alt=""
        width="120"
        height="115"
        class="site-header__logo-img"
      />
    </a>

    <PrimaryNav />

    <div class="site-header__actions">
      <Button href={becomeAMember.href} size="sm" class="site-header__cta">
        {becomeAMember.label}
      </Button>

      <MobileNav />
    </div>
  </div>
</header>

<script>
  import '../../scripts/nav';
</script>

<style>
  #scroll-sentinel {
    position: absolute;
    inset-block-start: 0;
    block-size: 1px;
    inline-size: 1px;
  }

  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: var(--z-sticky);
    /* Shorter than the desktop bar. At 72px on a 360px-wide screen the header
       claims a disproportionate slice of the first viewport before any
       content has been seen; 64px is still well clear of the 44px hit-area
       floor and reads as a considered mobile bar rather than a shrunk
       desktop one. Raised from 60px to keep real margin around the larger
       52px logo rather than the two nearly touching the header's edges. */
    block-size: 64px;
    background-color: var(--surface-page);
    border-block-end: 1px solid var(--line-subtle);
    transition:
      block-size var(--duration-base) var(--ease-out),
      background-color var(--duration-base) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out);
  }

  .site-header.is-compact {
    block-size: 56px;
  }

  /* The frosted state. `.is-compact` is already the exact "scrolled past the
     sentinel" signal nav.ts computes for the height change above — reused
     here rather than adding a second class for what is the same moment. Gated
     on backdrop-filter support: a browser that cannot blur what is behind the
     header does not get a thinner background colour with nothing softening
     what shows through it. */
  @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
    .site-header.is-compact {
      background-color: color-mix(in srgb, var(--surface-page) 90%, transparent);
      backdrop-filter: blur(14px) saturate(160%);
      -webkit-backdrop-filter: blur(14px) saturate(160%);
      box-shadow: var(--shadow-sm);
    }
  }

  .site-header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    block-size: 100%;
  }

  .site-header__logo {
    display: inline-flex;
    align-items: center;
    flex: none;
  }

  .site-header__logo-img {
    block-size: 52px;
    inline-size: auto;
    transition: block-size var(--duration-base) var(--ease-out);
  }

  .is-compact .site-header__logo-img {
    block-size: 44px;
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  /* !important is load-bearing here, not a shortcut. This selector and
     Button.astro's own `.btn { display: inline-flex }` base rule have equal
     specificity (one class, one attribute selector each), so which one wins
     depends on which compiled CSS chunk Vite/Rollup happens to load later,
     production build to production build, without ever changing a line of
     source. That is exactly the silent, order-dependent breakage this
     property exists to rule out (WUFPA-097: the button reappeared in the
     mobile header on a live deploy while local dev, whose chunking differs,
     showed it correctly hidden). Every other `display: none` in this
     codebase that gates a component's own default visibility already uses
     `!important` for the same reason (see MobileNav's `[hidden]` rules). */
  .site-header__cta {
    display: none !important;
  }

  @media (min-width: 48rem) {
    .site-header {
      block-size: 76px;
    }

    .site-header.is-compact {
      block-size: 64px;
    }

    .site-header__bar {
      gap: var(--space-4);
    }

    .site-header__logo-img {
      block-size: 60px;
    }

    .is-compact .site-header__logo-img {
      block-size: 52px;
    }
  }

  @media (min-width: 64rem) {
    .site-header__cta {
      display: inline-flex !important;
    }
  }
</style>
