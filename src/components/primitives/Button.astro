---
import Icon from './Icon.astro';
import type { IconName } from '../../lib/icons';

/**
 * Button — 4 variants x 3 sizes.
 *
 * Renders <a> when `href` is present, <button> otherwise. Never a <div> with a
 * click handler — that is how the prototype's slider dots were built, and they
 * were unreachable by keyboard.
 *
 * CONTRAST NOTE: white on #ED1B24 is 4.39:1, which qualifies as large text only
 * at >=19px bold / >=24px regular. Primary labels are therefore 17px weight 600
 * and MUST be verified in audit; escalate to 18px/700 if in doubt. This is the
 * one place the brand red works near its limit (docs/07 section 7.1).
 *
 * Minimum 44x44px hit area at every size (WCAG 2.5.8, and a real requirement on
 * a phone held one-handed outdoors).
 */
interface Props {
  variant?: 'primary' | 'secondary' | 'tertiary' | 'inverse';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  icon?: IconName;
  /** Full width below --bp-sm when this is a page's primary action. */
  block?: boolean;
  disabled?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  type = 'button',
  icon,
  block = false,
  disabled = false,
  class: className,
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';
/* Primary and inverse get the sweep-and-reveal treatment (see .btn__sweep
   below); secondary and tertiary stay as plain colour-swap controls, since a
   bordered or inline control filling with a solid dot reads as it becoming a
   different kind of control rather than responding to the cursor. */
const sweeps = variant === 'primary' || variant === 'inverse';
const classes = [
  'btn',
  `btn--${variant}`,
  `btn--${size}`,
  block ? 'btn--block' : '',
  sweeps ? 'btn--sweep' : '',
  className,
]
  .filter(Boolean)
  .join(' ');
---

<Tag
  class={classes}
  href={href}
  type={href ? undefined : type}
  aria-disabled={disabled ? 'true' : undefined}
  {...rest}
>
  {
    sweeps && (
      <>
        <span class="btn__sweep" aria-hidden="true" />
        <span class="btn__face btn__face--reveal" aria-hidden="true">
          <slot />
          <Icon name="arrow-right" />
        </span>
      </>
    )
  }
  <span class="btn__label btn__face"><slot /></span>
  {!sweeps && icon && <Icon name={icon} />}
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    font-family: var(--font-ui);
    font-weight: var(--weight-semibold);
    line-height: 1;
    text-align: center;
    text-decoration: none;
    border: 1.5px solid transparent;
    border-radius: var(--radius-control);
    cursor: pointer;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out),
      translate var(--duration-fast) var(--ease-out),
      scale var(--duration-instant) var(--ease-out);
    /* Guarantees a 44px hit area even where the visual height is smaller. */
    min-block-size: var(--target-min);
  }

  /* A hairline lift on hover, filled and bordered variants only — the
     tertiary link stays flat since it is inline text, not a raised control,
     and lifting it would misrepresent what it is. 1px is deliberately
     small: enough to register as "this responds to you" without the
     button drifting away from a cursor that has already arrived. */
  .btn--primary:hover,
  .btn--secondary:hover,
  .btn--inverse:hover {
    translate: 0 -1px;
    box-shadow: var(--shadow-sm);
  }

  .btn--primary:active,
  .btn--secondary:active,
  .btn--inverse:active {
    translate: 0 0;
    box-shadow: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .btn--primary:hover,
    .btn--secondary:hover,
    .btn--inverse:hover {
      translate: 0 0;
    }
  }

  /* PRESS, NOT HOVER. The scale is on :active only — a button that grows under
     the cursor is a startup gesture, but a button that gives under the finger
     confirms the tap landed, which on a mid-range Android over slow data is
     real information: it tells the user the press registered before the next
     page has begun to load. --duration-instant, because feedback the user has
     to wait for is not feedback.

     0.98, and it must stay near that. Anything deeper reads as a toy, and on a
     44px control a large scale visibly shifts the hit area under a finger that
     is already committed to the press. */
  .btn:active:not([aria-disabled='true']) {
    scale: 0.98;
  }

  /* The icon leads by a hair on hover: direction, not decoration. Only where
     an icon is actually present, and only 2px: enough to read as intent,
     nowhere near enough to detach from the label. Scoped off `.btn--sweep`,
     whose reveal face already carries its own arrow into the button on a
     different transform (see .btn__face--reveal above); stacking this on
     top of that one would move the arrow twice. */
  .btn:not(.btn--sweep) :global(svg) {
    transition: translate var(--duration-fast) var(--ease-out);
  }

  .btn:not(.btn--sweep):hover :global(svg) {
    translate: 2px 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .btn:active:not([aria-disabled='true']) {
      scale: 1;
    }

    .btn:hover :global(svg) {
      translate: 0 0;
    }
  }

  /* Sizes */
  .btn--sm {
    block-size: var(--control-height-sm);
    padding-inline: var(--space-4);
    font-size: var(--text-sm);
  }
  .btn--md {
    block-size: var(--control-height);
    padding-inline: var(--space-5);
    font-size: var(--text-base);
  }
  .btn--lg {
    block-size: var(--control-height-lg);
    padding-inline: var(--space-6);
    font-size: var(--text-base);
  }

  .btn--block {
    inline-size: 100%;
  }

  /* Primary */
  .btn--primary {
    background-color: var(--action-primary-bg);
    color: var(--action-primary-text);
  }
  .btn--primary:hover {
    background-color: var(--action-primary-bg-hover);
    color: var(--action-primary-text);
  }
  .btn--primary:active {
    background-color: var(--action-primary-bg-active);
  }

  /* Secondary */
  .btn--secondary {
    background-color: transparent;
    color: var(--action-secondary-text);
    border-color: var(--action-secondary-border);
  }
  .btn--secondary:hover {
    background-color: var(--action-secondary-bg-hover);
    color: var(--action-secondary-text);
  }

  /* Tertiary — inline, low emphasis. Underlined so it is not colour-only. */
  .btn--tertiary {
    background-color: transparent;
    color: var(--link);
    padding-inline: var(--space-2);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .btn--tertiary:hover {
    color: var(--link-hover);
  }

  /* Inverse — for use on --surface-inverse */
  .btn--inverse {
    background-color: var(--action-inverse-bg);
    color: var(--action-inverse-text);
  }
  .btn--inverse:hover {
    background-color: var(--action-inverse-bg-hover);
    color: var(--action-inverse-text);
  }

  /* ── Sweep-and-reveal (primary + inverse) ─────────────────────────────
     On hover: the plain label slides out and fades, a second label-plus-
     arrow face slides in from the same edge to take its place, and a small
     dot grows from that edge to cover the button, which is what gives the
     incoming face's own colour (it sits above the dot in paint order). The
     button's OWN background-colour hover transition still runs underneath,
     so a slow click or a device that ignores the dot (forced-colors mode,
     for instance) still gets the plain, already-shipped colour-swap. */
  .btn--sweep {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }

  .btn__face {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
  }

  .btn--sweep .btn__label {
    transition:
      translate var(--duration-base) var(--ease-out),
      opacity var(--duration-base) var(--ease-out);
  }

  .btn--sweep:hover .btn__label {
    translate: 0.75rem 0;
    opacity: 0;
  }

  .btn__face--reveal {
    position: absolute;
    inset: 0;
    z-index: 1;
    translate: -0.75rem 0;
    opacity: 0;
    color: inherit;
    transition:
      translate var(--duration-base) var(--ease-out),
      opacity var(--duration-base) var(--ease-out);
  }

  .btn--sweep:hover .btn__face--reveal {
    translate: 0 0;
    opacity: 1;
  }

  /* The growing dot. Starts as a small circle tucked in the leading corner,
     the same corner the reveal face arrives from, and scales up past the
     button's own diagonal so it fully covers the corners, not just the
     inscribed circle. transform-origin stays put at that corner throughout,
     so it reads as unfurling FROM the edge rather than growing from the
     centre outward. */
  .btn__sweep {
    position: absolute;
    z-index: 0;
    inset-block-start: 50%;
    inset-inline-start: 0;
    inline-size: 1.25rem;
    block-size: 1.25rem;
    translate: -50% -50%;
    scale: 0;
    border-radius: var(--radius-full);
    background-color: var(--action-primary-bg-active);
    transition: scale var(--duration-base) var(--ease-out);
  }

  .btn--inverse .btn__sweep {
    background-color: var(--action-inverse-bg-hover);
  }

  .btn--sweep:hover .btn__sweep {
    scale: 20;
  }

  @media (prefers-reduced-motion: reduce) {
    .btn--sweep .btn__label,
    .btn__face--reveal,
    .btn__sweep {
      transition: none;
    }

    /* Reduced motion loses the sweep and the crossfade, not the outcome: the
       reveal face and its arrow are still what the reader sees on hover,
       appearing and disappearing instantly rather than sliding. */
    .btn--sweep:hover .btn__label {
      opacity: 0;
    }

    .btn--sweep:hover .btn__face--reveal {
      opacity: 1;
    }

    .btn--sweep:hover .btn__sweep {
      scale: 20;
    }
  }

  /* aria-disabled rather than the disabled attribute: the control keeps its
     place in the tab order so a screen-reader user can discover why it is
     unavailable. Form submits are never disabled pending completion. */
  .btn[aria-disabled='true'] {
    opacity: 0.55;
    cursor: not-allowed;
    pointer-events: none;
  }

  @media (max-width: 30rem) {
    .btn--block-mobile {
      inline-size: 100%;
    }
  }
</style>
