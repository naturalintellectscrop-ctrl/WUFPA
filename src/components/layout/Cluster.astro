---
/**
 * Cluster — horizontal grouping that wraps. Tags, button rows, meta lines.
 *
 * Wraps rather than scrolls or truncates, which matters more here than usual:
 * Ugandan names and district labels are long, and a row of them at 320px will
 * wrap. Designing for that up front is cheaper than discovering it in QA.
 *
 * CSS contract lives in global.css @layer layout (.cluster).
 *
 * Source: docs/07 section 5.3 - WUFPA-015
 */
import type { SpaceToken } from '../../lib/types';

interface Props {
  gap?: SpaceToken;
  /** Cross-axis alignment. `baseline` aligns text of differing sizes. */
  align?: 'center' | 'start' | 'end' | 'baseline' | 'stretch';
  /** Main-axis distribution. */
  justify?: 'start' | 'center' | 'end' | 'between';
  as?: 'div' | 'ul' | 'ol' | 'nav' | 'p' | 'span';
  class?: string;
}

const {
  gap,
  align = 'center',
  justify = 'start',
  as: Tag = 'div',
  class: className,
}: Props = Astro.props;

const justifyMap: Record<NonNullable<Props['justify']>, string> = {
  start: 'flex-start',
  center: 'center',
  end: 'flex-end',
  between: 'space-between',
};

const styles = [
  gap !== undefined ? `gap: var(--space-${gap})` : null,
  align !== 'center' ? `align-items: ${align}` : null,
  justify !== 'start' ? `justify-content: ${justifyMap[justify]}` : null,
]
  .filter(Boolean)
  .join('; ');
---

<Tag class:list={['cluster', className]} style={styles || undefined}>
  <slot />
</Tag>
