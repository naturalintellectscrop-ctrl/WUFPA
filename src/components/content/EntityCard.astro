---
import Tag from '../primitives/Tag.astro';

/**
 * EntityCard — ONE component, six variants.
 *
 * The prototype had three unrelated card treatments (.exec-card, .member-card,
 * .gallery-item) with no shared abstraction — which is how design systems
 * fragment. One component with six configurations stays consistent; six
 * components drift apart.
 *
 * ACCESSIBILITY CONTRACT: the whole card is one link, OR the card contains
 * links — never both. Nested interactive elements break keyboard navigation and
 * screen-reader output. When `href` is given, a pseudo-element overlay on the
 * heading's anchor extends the hit area over the card, so the accessible name
 * is the heading and the target is the whole card.
 */
interface Props {
  variant?: 'programme' | 'region' | 'guild' | 'article' | 'event' | 'album';
  title: string;
  href?: string;
  description?: string;
  /** Small label above the title — date, type, craft. */
  eyebrow?: string;
  /** Key/value pairs shown beneath, e.g. coordinator or district count. */
  meta?: { label: string; value: string }[];
  tags?: string[];
  image?: { src: string; alt: string; width: number; height: number; objectPosition?: string };
  class?: string;
}

const {
  variant = 'programme',
  title,
  href,
  description,
  eyebrow,
  meta = [],
  tags = [],
  image,
  class: className,
} = Astro.props;

const clickable = Boolean(href);
---

<article class:list={['card', `card--${variant}`, clickable && 'card--clickable', className]}>
  {
    image && (
      <div
        class="frame card__media"
        style={`--frame-ratio: var(--ratio-landscape); --frame-position: ${image.objectPosition ?? 'center'};`}
      >
        <img
          src={image.src}
          alt={image.alt}
          width={image.width}
          height={image.height}
          loading="lazy"
          decoding="async"
        />
      </div>
    )
  }

  <div class="card__body">
    {eyebrow && <p class="card__eyebrow">{eyebrow}</p>}

    <h3 class="card__title">
      {clickable ? <a href={href}>{title}</a> : title}
    </h3>

    {description && <p class="card__description">{description}</p>}

    {
      meta.length > 0 && (
        <dl class="card__meta">
          {meta.map((m) => (
            <div class="card__meta-row">
              <dt>{m.label}</dt>
              <dd>{m.value}</dd>
            </div>
          ))}
        </dl>
      )
    }

    {
      tags.length > 0 && (
        <div class="cluster card__tags">
          {tags.map((t) => (
            <Tag variant="neutral">{t}</Tag>
          ))}
        </div>
      )
    }
  </div>
</article>

<style>
  .card {
    /* Establishes the query container the rule at the foot of this file needs.
       WUFPA-081: that @container rule shipped with WUFPA-025 and had NEVER
       matched, because `container-type` was declared nowhere in the repository —
       a query with no container ancestor silently never applies. Named `card`
       rather than left anonymous so a card nested inside another card resolves
       to its own container and not its grandparent's. */
    container: card / inline-size;
    position: relative;
    display: flex;
    flex-direction: column;
    background-color: var(--surface-page);
    border: 1px solid var(--line-subtle);
    border-radius: var(--radius-card);
    overflow: hidden;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }

  /* Hover applies shadow and border only. No transform: movement across a grid
     of cards causes visual noise and re-triggers hover on the neighbour. */
  .card--clickable:hover {
    border-color: var(--line-default);
    box-shadow: var(--shadow-sm);
  }

  /* The overlay makes the whole card a target while keeping the accessible
     name as the heading text. */
  .card--clickable .card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card__media {
    background-color: var(--surface-muted);
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--card-padding);
  }

  .card__eyebrow {
    margin: 0;
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .card__title {
    margin: 0;
    font-size: var(--text-xl);
  }

  .card__title a {
    color: inherit;
    text-decoration: none;
  }

  .card--clickable:hover .card__title a {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .card__description {
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--text-secondary);
  }

  .card__meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin: 0;
    font-size: var(--text-sm);
  }

  .card__meta-row {
    display: flex;
    gap: var(--space-2);
  }

  .card__meta dt {
    color: var(--text-muted);
  }

  .card__meta dd {
    margin: 0;
    color: var(--text-body);
    font-weight: var(--weight-medium);
  }

  /* Container query: the card adapts to ITS width, not the viewport's, so the
     same component works in a sidebar and in a three-up grid.

     This is what docs/21 section 12 means by "recompose, don't resize" at
     component scale — a media query here would ask the VIEWPORT how wide the
     card is, which is the wrong question the moment the card is placed in a
     narrow column on a wide screen. */
  @container card (min-width: 30rem) {
    .card--article .card__body {
      padding: var(--space-6);
    }
  }
</style>
