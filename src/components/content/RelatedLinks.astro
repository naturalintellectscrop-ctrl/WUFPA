---
/**
 * RelatedLinks — the exit from a page that is not the navigation.
 *
 * WHY THIS IS AN SEO COMPONENT AND NOT DECORATION
 *
 * Navigation links appear on every page, so a crawler learns almost nothing
 * from them about how any individual page relates to any other. Contextual
 * links inside content are what turn a set of pages into a navigable body of
 * evidence — they distribute authority along real relationships and give a
 * reader who arrived from search somewhere to go that isn't "back".
 *
 * THE ONE RULE (WUFPA-066): links are chosen by RELATIONSHIP, never recency.
 *
 * Auto-populating with "the latest three articles" produces identical links on
 * every page, which teaches readers to ignore the region entirely and teaches
 * the crawler nothing. So this component takes an explicit list — the calling
 * page states why each link belongs, and `reason` renders as visible context.
 *
 * The 2–4 bound is enforced, not suggested: one link is not a section, and
 * beyond four this becomes a second navigation.
 *
 * Source: docs/05 section 6.1 (key link paths) · docs/16 section 3
 */

export interface RelatedLink {
  /** Descriptive anchor text. Never "click here", never a bare URL. */
  label: string;
  href: string;
  /** Why this is related — one short line, shown to the reader. */
  reason?: string;
}

interface Props {
  links: RelatedLink[];
  /** docs/04 section 1.3 fixes the default string as "Related". */
  heading?: string;
  /** Heading level, so this never breaks the page's outline. A page whose
   *  content ends at h2 passes 2; one that ends at h3 passes 3. */
  headingLevel?: 2 | 3;
  class?: string;
}

const { links, heading = 'Related', headingLevel = 2, class: className } = Astro.props;

const Heading = `h${headingLevel}` as const;

// A build-time failure rather than a silent degradation: an under- or
// over-populated Related block is a content bug, and finding it at build is
// cheaper than finding it in an audit six months later.
if (links.length < 2 || links.length > 4) {
  throw new Error(
    `RelatedLinks expects 2–4 links, received ${links.length}. ` +
      'Links are chosen by relationship (WUFPA-066) — if there are fewer than two ' +
      'genuine relationships, omit the component rather than padding it.',
  );
}

const headingId = 'related-links-heading';
---

<nav class:list={['related', className]} aria-labelledby={headingId}>
  <Heading id={headingId} class="related__heading">{heading}</Heading>

  <ul role="list" class="related__list">
    {
      links.map((link) => (
        <li class="related__item">
          <a class="related__link" href={link.href}>
            {link.label}
          </a>
          {link.reason && <p class="related__reason">{link.reason}</p>}
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .related {
    margin-block-start: var(--space-8);
    padding-block-start: var(--space-6);
    border-block-start: 1px solid var(--line-subtle);
  }

  .related__heading {
    margin: 0 0 var(--space-5);
    font-size: var(--text-xl);
  }

  .related__list {
    display: grid;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 40rem) {
    .related__list {
      grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    }
  }

  .related__link {
    font-family: var(--font-ui);
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
    color: var(--text-accent);
    /* Underlined by default: docs/16 section 8.1, criterion 1.4.1 — link
       identity never depends on colour alone. */
    text-decoration: underline;
    text-underline-offset: 0.15em;

    /* 44×44 minimum target (docs/16 section 9), met by padding the block axis
       rather than by a fixed height, so the target grows with the text. */
    display: inline-block;
    padding-block: var(--space-2);
  }

  .related__reason {
    margin: var(--space-1) 0 0;
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--text-secondary);
  }
</style>
