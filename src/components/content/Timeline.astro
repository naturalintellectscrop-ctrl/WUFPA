---
/**
 * Timeline — the history page and any dated sequence.
 *
 * An ordered list, because chronology is meaningful order.
 *
 * Undated entries are grouped in a clearly-labelled section rather than
 * interleaved at a guessed position. Roughly a third of WUFPA's documented
 * activity carries no year (docs/02 section 3) — "date not recorded" is a
 * legitimate published state and inventing precision is not.
 */
import type { TimelineEntry } from '../../lib/types';

interface Props {
  entries: TimelineEntry[];
  class?: string;
}

const { entries, class: className } = Astro.props;

const dated = entries.filter((e) => e.dateLabel);
const undated = entries.filter((e) => !e.dateLabel);
---

<div class:list={['timeline', className]}>
  <ol class="timeline__list" role="list">
    {
      dated.map((e) => (
        <li class="timeline__item reveal">
          <div class="timeline__date">
            {e.date ? <time datetime={e.date}>{e.dateLabel}</time> : e.dateLabel}
          </div>
          <div class="timeline__content">
            <h3>{e.title}</h3>
            {e.description && <p>{e.description}</p>}
          </div>
        </li>
      ))
    }
  </ol>

  {
    undated.length > 0 && (
      <section class="timeline__undated" aria-labelledby="timeline-undated-heading">
        <h3 id="timeline-undated-heading" class="timeline__undated-heading">
          Date not recorded
        </h3>
        <p class="timeline__undated-note">
          These activities are documented in WUFPA's association profile but carry no date. They
          are listed separately rather than placed at a guessed position.
        </p>
        <ul class="timeline__list" role="list">
          {undated.map((e) => (
            <li class="timeline__item timeline__item--undated">
              <div class="timeline__content">
                <h4>{e.title}</h4>
                {e.description && <p>{e.description}</p>}
              </div>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</div>

<style>
  .timeline__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .timeline__item {
    display: grid;
    gap: var(--space-1) var(--space-5);
    padding-block: var(--space-5);
    border-block-start: 1px solid var(--line-subtle);
  }

  .timeline__date {
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--text-accent);
    font-variant-numeric: tabular-nums;
  }

  .timeline__content h3,
  .timeline__content h4 {
    margin: 0 0 var(--space-2);
    font-size: var(--text-lg);
  }

  .timeline__content p {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .timeline__undated {
    margin-block-start: var(--space-7);
    padding-block-start: var(--space-5);
    border-block-start: 2px solid var(--line-default);
  }

  .timeline__undated-heading {
    margin: 0 0 var(--space-2);
    font-size: var(--text-lg);
    color: var(--text-muted);
  }

  .timeline__undated-note {
    margin: 0 0 var(--space-4);
    font-size: var(--text-sm);
    color: var(--text-muted);
    max-inline-size: var(--measure-narrow);
  }

  /* Two-column from --bp-md. DOM order is unchanged — visual alternation must
     never require reordering the source. */
  @media (min-width: 48rem) {
    .timeline__item {
      grid-template-columns: 9rem 1fr;
    }

    /* THE THREAD. From --bp-md the date column is fixed-width, which gives a
       stable axis for a hairline to run down — so chronology reads as one
       continuous line the reader travels rather than as unrelated rows that
       happen to be stacked. It exists only where the two-column layout does;
       on a single-column phone there is no axis for it to follow.

       It draws itself per entry: each item's own segment scales from the top
       as that item reveals, so the line advances WITH the reader instead of
       being pre-drawn to a future they have not scrolled to yet. That is the
       whole difference between a progress cue and a decoration. */
    .timeline__item {
      position: relative;
    }

    .timeline__item::before {
      content: '';
      position: absolute;
      inset-block: 0;
      /* Centred in the gap between the date column and the content column. */
      inset-inline-start: calc(9rem - var(--space-5) / 2);
      inline-size: 1px;
      background-color: var(--line-accent);
      transform-origin: top center;
      scale: 1 0;
    }

    :global(html.js-reveal) .timeline__item::before {
      transition: scale var(--duration-slower) var(--ease-out);
    }

    .timeline__item.is-visible::before,
    :global(html:not(.js-reveal)) .timeline__item::before {
      scale: 1 1;
    }
  }

  /* The line is the one piece of this component that must not animate under
     reduced motion — a scaling rule beside text is exactly the peripheral
     movement the setting exists to remove. It is drawn, complete, immediately. */
  @media (prefers-reduced-motion: reduce) {
    .timeline__item::before {
      scale: 1 1;
      transition: none;
    }
  }
</style>
